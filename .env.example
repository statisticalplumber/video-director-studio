# Copy to .env and adjust. .env is gitignored. Every setting is optional.

# ComfyUI API base URL (default: local ComfyUI)
COMFY_BASE="http://localhost:8188"

# Local OpenAI-compatible LLM (e.g. llama-server) for "Write with AI" in the studio
LLM_BASE="http://localhost:8080"

# Studio login (defaults: admin / admin — change for anything non-local)
LOGIN_USER="admin"
LOGIN_PASS="admin"

# Studio server port (default 8790)
# PORT=8790

# Where the base workflow JSONs live (default: workflows/)
# WORKFLOWS_DIR="/path/to/workflows"
